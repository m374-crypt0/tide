# the name of this tide project
TIDE_PROJECT_NAME=tide

# The official registry image hosted on hub.docker.com
REGISTRY_OFFICIAL_REGISTRY_IMAGE_NAME=registry:3

# The registry host
REGISTRY_HOST=localhost

# The registry will be reachable on this port
REGISTRY_PORT=5000

# The registry built image name
REGISTRY_IMAGE_NAME="${TIDE_PROJECT_NAME}-registry"

# The running registry container name
REGISTRY_CONTAINER_NAME="${REGISTRY_IMAGE_NAME}"

# The user name able to use the registry
REGISTRY_USER_NAME="$(id -nu)"

# The user password
REGISTRY_USER_PASSWORD=p4ssw0rd
