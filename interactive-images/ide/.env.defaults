# the name of this tide project
TIDE_PROJECT_NAME="${TIDE_PROJECT_NAME:-tide}"

# the ide docker image name
IDE_IMAGE_NAME="${TIDE_PROJECT_NAME}-ide"

# the ide container name
IDE_CONTAINER_NAME="${IDE_IMAGE_NAME}"

# the host name to give to the ide running container
IDE_HOSTNAME="${TIDE_PROJECT_NAME}_ide"

# the bash-it commit to checkout
IDE_BASH_IT_REVISION=ee8396b5a049ae648b9a75575507984d27a119bb

# the minimal-emacs.d commit to checkout
IDE_MINIMAL_EMACS_REVISION=0916b1890604372daf70036762f92965f9bb5b47

# the host ssh agent socket to share with the container
IDE_SSH_AUTH_SOCK_HOST="$SSH_AUTH_SOCK"

# the path of the ssh agent socket in the container
IDE_SSH_AUTH_SOCK_CONTAINER="/home/${NON_ROOT_USER_NAME}/.ssh-auth-sock"

# the name of the user storage directory mounted in the user directory
IDE_USER_STORAGE_DIR_NAME=workspace
