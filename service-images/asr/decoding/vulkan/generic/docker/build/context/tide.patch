diff --git a/examples/bench/CMakeLists.txt b/examples/bench/CMakeLists.txt
index f255f2d..db129aa 100644
--- a/examples/bench/CMakeLists.txt
+++ b/examples/bench/CMakeLists.txt
@@ -1,8 +1,20 @@
 set(TARGET whisper-bench)
 add_executable(${TARGET} bench.cpp)

+find_library(STATIC_LIBCXX NAMES libc++.a HINTS "$ENV{HOME}/.local/.llvm/lib/x86_64-alpine-linux-musl/" REQUIRED)
+find_library(STATIC_LIBCXXABI NAMES libc++abi.a HINTS "$ENV{HOME}/.local/.llvm/lib/x86_64-alpine-linux-musl/" REQUIRED)
+find_library(STATIC_LIBUNWIND NAMES libunwind.a HINTS "$ENV{HOME}/.local/.llvm/lib/x86_64-alpine-linux-musl/" REQUIRED)
+
 include(DefaultTargetOptions)

 target_link_libraries(${TARGET} PRIVATE whisper ${CMAKE_THREAD_LIBS_INIT})

+# Link the static C++ runtime archives
+target_link_libraries(${TARGET} PRIVATE
+    -Wl,-Bstatic
+    ${STATIC_LIBCXX}
+    ${STATIC_LIBCXXABI}
+    ${STATIC_LIBUNWIND}
+    -Wl,-Bdynamic)
+
 install(TARGETS ${TARGET} RUNTIME)
