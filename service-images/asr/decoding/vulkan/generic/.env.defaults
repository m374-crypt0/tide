# the name of this tide project
TIDE_PROJECT_NAME="${TIDE_PROJECT_NAME:-tide}"

# TODO: wrong non-root-user-references to fix
# The advg built image name
ADVG_IMAGE_NAME="${TIDE_PROJECT_NAME}-advg"

# the advg container name
ADVG_CONTAINER_NAME="${ADVG_IMAGE_NAME}"

# The revision of ggml-org/whisper.cpp.git to use
ADVG_WHISPER_CPP_REVISION=b1535f5fb163f4443804888f7be980621226cb15

# the render group identifier to use. Must map something coherent with the host
# machine. Default value should do well.
ADVG_RENDER_GROUP_ID=$(getent group render | sed -E 's/render:x:([0-9]+)(:.*)?/\1/')

# the render group identifier to use. Must map something coherent with the host
# machine. Default value should do well.
ADVG_VIDEO_GROUP_ID=$(getent group video | sed -E 's/video:x:([0-9]+)(:.*)?/\1/')

# the render group identifier to use. Must map something coherent with the host
# machine. Default value should do well.
ADVG_AUDIO_GROUP_ID=$(getent group audio | sed -E 's/audio:x:([0-9]+)(:.*)?/\1/')

# your hugging face access token
ADVG_HUGGING_FACE_TOKEN=

# The published port of the decoding server for the selected model
ADVG_SERVER_PORT=9000

# the model to download and run (fetched from hugging face)
ADVG_MODEL=ggerganov/whisper.cpp/ggml-large-v3-turbo-q5_0.bin

# Supported models:
# ADVG_MODEL=ggerganov/whisper.cpp/ggml-large-v3-turbo-q5_0.bin

# the automatic void detection model (fetched from hugging face)
ADVG_VAD_MODEL=ggml-org/whisper-vad/ggml-silero-v6.2.0.bin

# Supported models:
# ADVG_VAD_MODEL=ggml-org/whisper-vad/ggml-silero-v6.2.0.bin
