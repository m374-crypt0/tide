# the name of this tide project
TIDE_PROJECT_NAME="${TIDE_PROJECT_NAME:-tide}"

# The non-root-user built image name
STRIX_HALO_IMAGE_NAME="${TIDE_PROJECT_NAME}-strix-halo"

# the strix-halo container name
STRIX_HALO_CONTAINER_NAME="${STRIX_HALO_IMAGE_NAME}"

# The revision of charlie12345/ROCmPFX.git to use
STRIX_HALO_ROCMPFX_REVISION=fb08d7cdb67082ddda15a25e64dc7ec413afc41c

# the render group identifier to use. Must map something coherent with the host
# machine. Default value should do well.
STRIX_HALO_RENDER_GROUP_ID=$(getent group render | sed -E 's/render:x:([0-9]+)(:.*)?/\1/')

# the render group identifier to use. Must map something coherent with the host
# machine. Default value should do well.
STRIX_HALO_VIDEO_GROUP_ID=$(getent group video | sed -E 's/video:x:([0-9]+)(:.*)?/\1/')

# your hugging face access token
STRIX_HALO_HUGGING_FACE_TOKEN=

# The published port of the inference server for the selected model
STRIX_HALO_MODEL_SERVER_PORT=8000

# the model to download and run (fetched from hugging face)
STRIX_HALO_MODEL=julianmb/Ornith-1.0-35B-ROCmFPX-StrixHalo/Ornith-1.0-35B-ROCmFPX-Speed-StrixHalo.gguf

# Supported models:
# STRIX_HALO_MODEL=julianmb/Ornith-1.0-35B-ROCmFPX-StrixHalo/Ornith-1.0-35B-ROCmFPX-Speed-StrixHalo.gguf
# STRIX_HALO_MODEL=julianmb/Ornith-1.0-35B-ROCmFPX-StrixHalo/Ornith-1.0-35B-ROCmFPX-Quality-StrixHalo.gguf
# STRIX_HALO_MODEL=jcbtc/Laguna-S-2.1-Chadrock-ROCmFP4-StrixKVSpine-V4-GGUF/laguna-s-2.1-ROCmFP4-StrixKVSpine-v4.gguf
