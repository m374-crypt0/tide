# the name of this tide project
TIDE_PROJECT_NAME="${TIDE_PROJECT_NAME:-tide}"

# The official registry image hosted on hub.docker.com
DOCKER_REGISTRY_OFFICIAL_REGISTRY_IMAGE_NAME=registry:3

# The registry host
DOCKER_REGISTRY_HOST=localhost

# The registry will be reachable on this port
DOCKER_REGISTRY_PORT=5000

# The registry built image name
DOCKER_REGISTRY_IMAGE_NAME="${TIDE_PROJECT_NAME}-registry"

# The running registry container name
DOCKER_REGISTRY_CONTAINER_NAME="${DOCKER_REGISTRY_IMAGE_NAME}"

# The user name able to use the registry
DOCKER_REGISTRY_USER_NAME="$(id -nu)"

# The user password
DOCKER_REGISTRY_USER_PASSWORD=p4ssw0rd
