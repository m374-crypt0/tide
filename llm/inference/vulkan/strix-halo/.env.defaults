# the name of this tide project
TIDE_PROJECT_NAME="${TIDE_PROJECT_NAME:-tide}"

# The non-root-user built image name
STRIX_HALO_IMAGE_NAME="${TIDE_PROJECT_NAME}-strix-halo"

# The revision of charlie12345/ROCmPFX.git to use
STRIX_HALO_ROCMPFX_REVISION=fb08d7cdb67082ddda15a25e64dc7ec413afc41c

# The published port of the inference server
STRIX_HALO_SERVER_PORT=8000

# the render group identifier to use. Must map something coherent with the host
# machine. Default value should do well.
STRIX_HALO_RENDER_GROUP_ID=$(getent group render | sed -E 's/render:x:([0-9]+)(:.*)?/\1/')

# the render group identifier to use. Must map something coherent with the host
# machine. Default value should do well.
STRIX_HALO_VIDEO_GROUP_ID=$(getent group video | sed -E 's/video:x:([0-9]+)(:.*)?/\1/')
