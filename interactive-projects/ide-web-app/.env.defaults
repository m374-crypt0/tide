# the name of this tide project
TIDE_PROJECT_NAME="${TIDE_PROJECT_NAME:-tide}"

# the ide docker image name
IDE_WEB_APP_IMAGE_NAME="${TIDE_PROJECT_NAME}-ide-web-app"

# the ide container name
IDE_WEB_APP_CONTAINER_NAME="${IDE_WEB_APP_IMAGE_NAME}"

# the host name to give to the ide running container
IDE_WEB_APP_HOSTNAME="${TIDE_PROJECT_NAME}_ide_web_app"

# the bun version to use
IDE_WEB_APP_BUN_VERSION=1.4.3

# a published port for the frontend part of your applications
IDE_WEB_APP_FRONTEND_PORT=8080

# a published port for the backend part of your applications
IDE_WEB_APP_BACKEND_PORT=3000
