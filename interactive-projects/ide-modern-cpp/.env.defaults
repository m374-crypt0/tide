# the name of this tide project
TIDE_PROJECT_NAME="${TIDE_PROJECT_NAME:-tide}"

# the ide docker image name
IDE_MODERN_CPP_IMAGE_NAME="${TIDE_PROJECT_NAME}-ide-modern-cpp"

# the ide container name
IDE_MODERN_CPP_CONTAINER_NAME="${IDE_MODERN_CPP_IMAGE_NAME}"

# the host name to give to the ide running container
IDE_MODERN_CPP_HOSTNAME="${TIDE_PROJECT_NAME}_ide_modern_cpp"
