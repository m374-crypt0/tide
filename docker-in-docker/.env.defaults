# the docker-in-docker docker image name
DOCKER_IN_DOCKER_IMAGE_NAME=tide-docker-in-docker

# the docker group id on the host machine
DOCKER_IN_DOCKER_DOCKER_GID="$(IFS=: read -r _ _ gid _ <<< $(getent group docker) && echo $gid)"

# the docker socket on the host
DOCKER_IN_DOCKER_SOCKET_PATH="$(docker context inspect --format '{{ .Endpoints.docker.Host }}' | sed -E 's%^unix://%%')"
